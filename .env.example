# --- Notion ---
# Create an internal integration at https://www.notion.so/profile/integrations
# then open the "Daily Task Manager" database -> ... -> Connections -> add your integration.
NOTION_TOKEN=
# Data source of the Daily Task Manager (not the unrelated second one in that database)
NOTION_DATA_SOURCE_ID=884cfc0c-ee75-82ea-bfe3-87095464a681
# Your Notion user ID (used to set Assignee). Find it via GET https://api.notion.com/v1/users
NOTION_USER_ID=

# --- App auth (single user) ---
APP_PASSCODE=
# Random 32+ char string used to sign the session cookie
SESSION_SECRET=

# --- Web Push (npm run vapid) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Cron ---
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" automatically when set.
CRON_SECRET=

# --- Schedule (all optional; defaults shown) ---
TZ_NAME=Asia/Kolkata
WORK_START=09:30
WORK_END=18:30
SLOT_MINUTES=15
# Comma-separated YYYY-MM-DD dates to skip
HOLIDAYS=

# --- Storage (optional, Upstash Redis / Vercel KV). Without it, state lives in memory + local file (dev only). ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
